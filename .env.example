NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRIVACY_CONTACT=
NEXT_PUBLIC_ENABLE_RACE_SENSITIVE_ITEMS=false
# Development/Playwright only; production builds always ignore this.
NEXT_PUBLIC_E2E_SHORT_QUIZ=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Vercel/Supabase integration aliases are also accepted:
# dnastorage_SUPABASE_URL=
# dnastorage_SUPABASE_SERVICE_ROLE_KEY=
# Must decode to exactly 32 bytes: openssl rand -base64 32
PROFILE_ENCRYPTION_KEY=
PROFILE_ENCRYPTION_KEY_VERSION=1
# Three independent secrets: openssl rand -base64 32 (never reuse one value)
SHARE_CODE_HMAC_KEY=
OWNER_TOKEN_HMAC_KEY=
RATE_LIMIT_HMAC_KEY=
# openssl rand -base64 48
CRON_SECRET=
# Cloudflare Turnstile. LEAVE BOTH UNSET.
# /api/compare enforces server-side verification as soon as TURNSTILE_SECRET_KEY
# is present, but the browser widget is not implemented yet and the CSP does not
# allow Cloudflare's script — setting the secret now makes every comparison fail.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
